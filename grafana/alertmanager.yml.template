global:
  resolve_timeout: 5m

route:
  receiver: default
  group_by: ["alertname", "service"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - service = rag-judge
      receiver: judge-slack
      continue: true
    # Silence-burn folder receiver policy (exclusive; before service=rag)
    - matchers:
        - grafana_folder =~ "rag-silence-burn|RAG Silence Burn"
      receiver: silence-burn-slack
      group_by: ["grafana_folder", "alertname"]
      group_wait: 15s
      group_interval: 2m
      repeat_interval: 1h
      mute_time_intervals:
        - silence-burn-quiet
      active_time_intervals:
        - silence-burn-business
      continue: false
    - matchers:
        - alertname = RagInhibitEqualCanarySilenceBurn
      receiver: silence-burn-slack
      group_by: ["grafana_folder", "alertname"]
      group_wait: 15s
      group_interval: 2m
      repeat_interval: 1h
      mute_time_intervals:
        - silence-burn-quiet
      active_time_intervals:
        - silence-burn-business
      continue: false
    # Quarantine before broad ingest catch-up route
    - matchers:
        - alertname = RagDualWriteDlqQuarantineDepthHigh
      receiver: ingest-dlq-quarantine-webhook
      continue: true
    - matchers:
        - service = rag-ingest
      receiver: ingest-webhook
      continue: true
    - matchers:
        - service = rag
      receiver: rag-webhook
      continue: true

receivers:
  - name: default
    webhook_configs:
      - url: ${RAG_ALERTMANAGER_WEBHOOK_URL}
        send_resolved: true

  # Slack Incoming Webhook — envsubst ile doldurulur.
  - name: judge-slack
    slack_configs:
      - api_url: '${RAG_ALERTMANAGER_SLACK_WEBHOOK}'
        channel: '#rag-judge'
        send_resolved: true
        title: '{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}'
        text: >-
          {{ range .Alerts -}}
          *{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{ end }}

  - name: silence-burn-slack
    slack_configs:
      - api_url: '${RAG_SILENCE_BURN_SLACK_WEBHOOK}'
        channel: '#rag-silence-burn'
        send_resolved: true
        title: '{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}'
        text: >-
          {{ range .Alerts -}}
          *{{ .Annotations.summary }}*
          runbook: {{ .Annotations.runbook_url }}
          {{ .Annotations.description }}
          {{ end }}

  - name: ingest-dlq-quarantine-webhook
    webhook_configs:
      - url: ${RAG_ALERTMANAGER_INGEST_DLQ_QUARANTINE_WEBHOOK_URL}
        send_resolved: true
        # Token: RAG_DUAL_WRITE_DLQ_QUARANTINE_WEBHOOK_TOKEN (or shared RAG_ALERTMANAGER_WEBHOOK_TOKEN)
        # HMAC: point URL at signing sidecar (docker compose --profile obs
        #   webhook-signing-sidecar → :8777) +
        #   RAG_DUAL_WRITE_DLQ_QUARANTINE_WEBHOOK_SIGNING_SECRET
        #   or shared RAG_ALERTMANAGER_WEBHOOK_SIGNING_SECRET
        # Optional: http_config.authorization.type=Bearer + credentials=<token>

  - name: ingest-webhook
    webhook_configs:
      - url: ${RAG_ALERTMANAGER_INGEST_WEBHOOK_URL}
        send_resolved: true
        # Optional: http_config.authorization Bearer RAG_ALERTMANAGER_WEBHOOK_TOKEN

  - name: rag-webhook
    webhook_configs:
      - url: ${RAG_ALERTMANAGER_WEBHOOK_URL}
        send_resolved: true

inhibit_rules:
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: ["alertname", "service"]
  # Silence-burn folder mute-window inhibition: when the burn alert is
  # firing, suppress sibling alerts in the same grafana_folder. Complements
  # mute_time_intervals silence-burn-quiet (notifications muted) with AM inhibit.
  # equal grafana_folder+service+team so only same-team folder siblings are suppressed.
  - source_matchers:
      - alertname = RagInhibitEqualCanarySilenceBurn
    target_matchers:
      - grafana_folder =~ "rag-silence-burn|RAG Silence Burn"
    equal: ["grafana_folder", "service", "team"]
  # Silence-burn folder: critical inhibits warning when grafana_folder is equal
  # (canonical slug + Grafana display-name label spellings).
  - source_matchers:
      - grafana_folder = rag-silence-burn
      - severity = critical
    target_matchers:
      - grafana_folder = rag-silence-burn
      - severity = warning
    equal: ["grafana_folder", "alertname", "service", "team"]
  - source_matchers:
      - grafana_folder = "RAG Silence Burn"
      - severity = critical
    target_matchers:
      - grafana_folder = "RAG Silence Burn"
      - severity = warning
    equal: ["grafana_folder", "alertname", "service", "team"]
  # Silence-burn folder: critical inhibits warning of the same alertname+service+team
  # even when grafana_folder slug vs display-name labels differ.
  - source_matchers:
      - grafana_folder =~ "rag-silence-burn|RAG Silence Burn"
      - severity = critical
    target_matchers:
      - grafana_folder =~ "rag-silence-burn|RAG Silence Burn"
      - severity = warning
    equal: ["alertname", "service", "team"]

time_intervals:
  - name: silence-burn-quiet
    time_intervals:
      - times:
          - start_time: "22:00"
            end_time: "08:00"
        location: UTC
      - weekdays: ["saturday", "sunday"]
        location: UTC
  - name: silence-burn-business
    time_intervals:
      - times:
          - start_time: "08:00"
            end_time: "22:00"
        weekdays: ["monday:friday"]
        location: UTC
