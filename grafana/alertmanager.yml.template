global:
  resolve_timeout: 5m

route:
  receiver: default
  group_by: ["alertname", "service"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - service = rag-judge
      receiver: judge-slack
      continue: true
    - matchers:
        - service = rag-ingest
      receiver: ingest-webhook
      continue: true
    - matchers:
        - service = rag
      receiver: rag-webhook
      continue: true

receivers:
  - name: default
    webhook_configs:
      - url: ${RAG_ALERTMANAGER_WEBHOOK_URL}
        send_resolved: true

  # Slack Incoming Webhook — envsubst ile doldurulur.
  - name: judge-slack
    slack_configs:
      - api_url: '${RAG_ALERTMANAGER_SLACK_WEBHOOK}'
        channel: '#rag-judge'
        send_resolved: true
        title: '{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}'
        text: >-
          {{ range .Alerts -}}
          *{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{ end }}

  - name: ingest-webhook
    webhook_configs:
      - url: ${RAG_ALERTMANAGER_INGEST_WEBHOOK_URL}
        send_resolved: true

  - name: rag-webhook
    webhook_configs:
      - url: ${RAG_ALERTMANAGER_WEBHOOK_URL}
        send_resolved: true

inhibit_rules:
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: ["alertname", "service"]
