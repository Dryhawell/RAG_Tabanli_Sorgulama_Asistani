{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Judge accuracy (latest)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "rag_judge_accuracy",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Soft-fail rate (1h)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(rag_judge_soft_fail_total[1h])) / clamp_min(sum(rate(rag_judge_runs_total[1h])), 1e-9)",
          "legendFormat": "soft_fail_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.3 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Judge runs by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (mode, ok) (rate(rag_judge_runs_total[5m]))",
          "legendFormat": "{{mode}} ok={{ok}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "Judge accuracy over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 4,
      "targets": [
        {
          "expr": "rag_judge_accuracy",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "type": "timeseries",
      "title": "Soft-fail events",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (mode) (rate(rag_judge_soft_fail_total[5m]))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM tokens (rate)",
      "description": "rag_llm_tokens_total by token_type. Enable Tempo/Jaeger datasource for exemplar→trace links from query latency panels.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (provider, model, token_type) (rate(rag_llm_tokens_total[5m]))",
          "legendFormat": "{{provider}}/{{model}} {{token_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "Query latency (exemplars)",
      "description": "Histogram exemplars attach OTel trace_id/span_id when available. Prometheus→Tempo via provisioning exemplarTraceIdDestinations.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_query_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A",
          "exemplar": true,
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "LLM cost est. (1h USD)",
      "description": "Recording rule rag:llm_cost_usd_1h (grafana/rules/rag_llm_cost.yml).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "id": 8,
      "targets": [
        {
          "expr": "rag:llm_cost_usd_1h",
          "legendFormat": "usd",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "LLM cost rate (USD/h est.)",
      "description": "Recording rule rag:llm_cost_usd_per_hour (see grafana/rules/rag_llm_cost.yml).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 24 },
      "id": 9,
      "targets": [
        {
          "expr": "rag:llm_cost_usd_per_hour",
          "legendFormat": "usd_per_hour",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 5 } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["rag", "judge", "soft-fail", "llm", "otel", "tempo"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
